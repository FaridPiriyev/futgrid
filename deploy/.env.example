# Copy to deploy/.env on the server. Never commit the real file.
# Public origin the browser uses (IP now, https://domain later — then rebuild `web`).
PUBLIC_URL=http://64.226.93.170
APP_URL=http://64.226.93.170
API_URL=http://64.226.93.170
CORS_ORIGINS=http://64.226.93.170,capacitor://localhost,https://localhost

# Must be false while serving plain HTTP; true after SSL.
COOKIE_SECURE=false
COOKIE_DOMAIN=

POSTGRES_PASSWORD=<openssl rand -hex 24>
JWT_ACCESS_SECRET=<openssl rand -hex 32>
TOKEN_PEPPER=<openssl rand -hex 32>
IP_HASH_SALT=<openssl rand -hex 32>

CDN_BASE_URL=http://64.226.93.170/cdn-data
MEDIA_BASE_URL=http://64.226.93.170/media

LOG_LEVEL=info
LOG_PRETTY=false
RATE_LIMIT_ENABLED=true

# Optional integrations
RESEND_API_KEY=
EMAIL_FROM=FutGrid <info@futgrid.az>
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://64.226.93.170/v1/auth/google/callback
SENTRY_DSN=
FCM_SERVICE_ACCOUNT_JSON=
