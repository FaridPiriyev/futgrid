{
  "name": "@futgrid/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsup src/server.ts --format esm --platform node --target node20 --out-dir dist --clean --sourcemap",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "duel:create": "node scripts/duel.mjs create",
    "duel:join": "node scripts/duel.mjs join"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1169.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^12.0.1",
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/static": "^10.1.11",
    "@fastify/swagger": "^9.4.0",
    "@fastify/swagger-ui": "^5.2.1",
    "@futgrid/game-core": "*",
    "@prisma/client": "^5.22.0",
    "@sentry/node": "^8.40.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "argon2": "^0.41.1",
    "dotenv": "^16.4.5",
    "fastify": "^5.2.0",
    "fastify-type-provider-zod": "^3.0.0",
    "firebase-admin": "^13.10.0",
    "ioredis": "^5.4.1",
    "jose": "^5.9.6",
    "node-cron": "^3.0.3",
    "otplib": "^13.6.0",
    "pino": "^9.5.0",
    "pino-pretty": "^13.2.0",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.17.6",
    "@types/node-cron": "^3.0.11",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.15.0",
    "prettier": "^3.3.3",
    "prisma": "^5.22.0",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.0.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0",
    "vitest": "^2.1.5"
  }
}
