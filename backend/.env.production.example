# PRODUCTION TEMPLATE — Railway + Neon + Upstash
# Copy these values into Railway's environment variables, or copy this file to .env
# on your server. Never commit the real .env file.

NODE_ENV=production
HOST=0.0.0.0
# Leave PORT empty on Railway so Railway can inject its own port.
PORT=
LOG_LEVEL=info

# Neon: use the direct connection string (not the "-pooler" host) for migrations.
DATABASE_URL=postgresql://<NEON_USER>:<NEON_PASSWORD>@<NEON_HOST>/<NEON_DB>?sslmode=require
# Upstash: copy the TLS rediss:// URL exactly.
REDIS_URL=rediss://default:<UPSTASH_PASSWORD>@<UPSTASH_HOST>:6379

ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
JWT_ACCESS_SECRET=<GENERATE_WITH_OPENSSL_RAND_HEX_32>
TOKEN_PEPPER=<GENERATE_WITH_OPENSSL_RAND_HEX_32>
IP_HASH_SALT=<GENERATE_WITH_OPENSSL_RAND_HEX_32>

# Cookies must be shared between futgrid.az and api.futgrid.az.
COOKIE_DOMAIN=.futgrid.az
COOKIE_SECURE=true
CORS_ORIGINS=https://futgrid.az,https://www.futgrid.az,https://staging.futgrid.az,capacitor://localhost,https://localhost
APP_URL=https://futgrid.az
API_URL=https://api.futgrid.az

DATA_DIR=../packages/game-core/data
DATA_VERSION=v1

# Required in production: verify the sending domain in Resend first.
RESEND_API_KEY=re_<RESEND_API_KEY>
EMAIL_FROM=FutGrid <info@futgrid.az>

# Optional. Leave empty if Google login is not used.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.futgrid.az/v1/auth/google/callback

# Optional.
SENTRY_DSN=

SWAGGER_ENABLED=false
GAME_SESSION_TTL_MINUTES=120
DAILY_RANKED_LIMIT=5
TEAM_LEADERBOARD_TOP=5
RATE_LIMIT_ENABLED=true
TRUST_PROXY=true
LOG_PRETTY=false

# Railway container paths. Use R2, or attach Railway volumes at these paths.
CDN_DATA_DIR=/app/cdn-data
CDN_MEDIA_DIR=/app/cdn-media
CDN_BASE_URL=https://api.futgrid.az/cdn-data
MEDIA_BASE_URL=https://api.futgrid.az/media

# Strongly recommended on Railway: without R2 or volumes, uploads are lost on deploy.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=https://cdn.futgrid.az

# Optional integrations. Empty is safe.
API_FOOTBALL_KEY=
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io
TRANSFERMARKT_CSV_URL=
ADMIN_TOTP_ISSUER=FutGrid
MEDIA_MAX_BYTES=10000000
MEDIA_MAX_WIDTH=640
FCM_SERVICE_ACCOUNT_JSON=
